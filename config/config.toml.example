# Githor — configuration
#
# Copier ce fichier vers config/config.toml puis adapter si nécessaire.
# Toutes les clés sont facultatives : les valeurs ci-dessous sont celles
# appliquées par défaut si le fichier est absent.
#
# Ce fichier ne doit JAMAIS contenir de secret : le token GitHub est lu
# exclusivement depuis la variable d'environnement GITHUB_TOKEN.
#
# Ordre de recherche, du plus prioritaire au moins prioritaire :
#   1. githor --config <fichier>
#   2. $GITHOR_CONFIG
#   3. config/config.toml, sous le répertoire de travail
#   4. ~/.config/githor/config.toml
#
# Les chemins relatifs sont résolus depuis le répertoire de travail courant.
# Une clé inconnue provoque une erreur explicite plutôt qu'un silence.

[github]
# Racine de l'API. À changer pour une instance GitHub Enterprise.
api_url = "https://api.github.com"

# Si GITHUB_TOKEN est absent, demander son jeton à la CLI gh (« gh auth token »).
# Évite d'exporter le jeton en permanence — ce qui serait risqué, gh préférant
# GITHUB_TOKEN à son propre trousseau. Mettre à false pour n'utiliser que
# la variable d'environnement.
use_gh_cli = true

[scan]
include_forks = false
include_archived = false
# Profondeur de l'historique de commits analysé, en jours (1 à 3650).
commit_history_days = 90

# Durée pendant laquelle une mesure déjà prise dispense d'en reprendre une,
# en heures (0 à 8760). Un dépôt mesuré il y a moins que cette durée est ignoré
# par « githor scan » : ni appel à GitHub, ni nouveau snapshot.
# La valeur 0 ne dispense de rien — chaque scan mesure tout.
# La relever économise le quota lors de scans rapprochés ; « --freshness »
# remplace ponctuellement cette valeur, et « --freshness 0 » force un scan complet.
snapshot_freshness_hours = 0

[audit]
# Racine sous laquelle « githor mirror » clone les dépôts, un répertoire par
# propriétaire. Ce répertoire appartient à Githor : il y remet les copies à
# l'état publié, et refuse de toucher tout dépôt qu'il n'a pas cloné lui-même.
workspace = "data/repos"

# Profondeur du clone superficiel (0 à 100000). L'analyse porte sur l'état du
# code, pas sur son passé : un seul commit suffit. La valeur 0 récupère tout
# l'historique, ce qui ne sert qu'à inspecter le miroir à la main.
clone_depth = 1

# Délai accordé à chaque commande git, clone compris, en secondes (1 à 3600).
git_timeout_seconds = 300

# Au-delà de cette taille, un fichier est compté mais pas analysé (1024 à
# 100000000 octets). Un fichier d'un mégaoctet n'est plus du code écrit à la
# main : l'analyser fausserait toutes les moyennes.
max_file_bytes = 1000000

[ollama]
# Serveur Ollama local utilisé par « githor advise ». Ollama tourne toujours
# en local : aucune donnée du dépôt n'est envoyée à un service tiers.
host = "http://localhost:11434"

# Modèle interrogé. Doit avoir été récupéré au préalable : ollama pull <modèle>.
model = "llama3.1"

# Délai accordé à une génération, en secondes (1 à 3600). L'inférence locale
# peut prendre plusieurs minutes selon le modèle et la machine ; un délai
# court la couperait avant qu'elle n'ait terminé.
timeout_seconds = 180.0

[web]
# Adresse d'écoute de « githor web ». Reste sur la machine locale par défaut :
# jamais exposée sur le réseau, même si la valeur peut être changée ici.
host = "127.0.0.1"

# Port d'écoute (1 à 65535).
port = 8765

[storage]
database = "data/githor.db"

[export]
directory = "data/exports"
